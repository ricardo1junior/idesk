DATABASE_URL="postgresql://idesk:idesk@localhost:5432/idesk"
# Chave para criptografar senhas de aparelhos. Gere com: openssl rand -base64 32
APP_SECRET=""

# Verificação de IMEI (opcional; sem as chaves o botão fica desativado)
# Anatel / Celular Legal via Infosimples: https://infosimples.com/consultas/anatel-celular-legal/
INFOSIMPLES_TOKEN=""
# iCloud, blacklist GSMA, operadora e garantia Apple via IMEI.org: https://imei.org/api-connect
IMEIORG_API_KEY=""
# Serviço usado no IMEI.org (171 = Apple Advanced Check). Veja a lista em /api/services.
IMEIORG_SERVICE_ID="171"

# Emissão de NF-e / NFC-e pela Focus NFe (https://focusnfe.com.br). Cada ambiente tem seu token.
FOCUSNFE_TOKEN_HOMOLOGACAO=""
FOCUSNFE_TOKEN_PRODUCAO=""

# Envio da OS e da venda por e-mail (SMTP do seu provedor: Gmail, Outlook, Zoho, hospedagem do domínio...)
# Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587" e uma "senha de app" em SMTP_PASS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_REMETENTE="" # ex.: contato@sualoja.com.br
EMAIL_RESPOSTA=""  # opcional: para onde vão as respostas do cliente
LOJA_NOME=""       # opcional: nome no remetente (padrão: nome fantasia dos dados fiscais)
