// Modelo de dados do iDesk (MVP: cadastros, aparelhos, OS, vendas e estoque).
// Valores monetários em Decimal(12,2). Documentos (CPF/CNPJ) guardados só com dígitos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuários ----------

enum Perfil {
  ADMIN
  VENDEDOR
  TECNICO
  FINANCEIRO
}

model Usuario {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  senhaHash  String
  perfil     Perfil   @default(VENDEDOR)
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  ordensTecnico OrdemServico[] @relation("TecnicoOS")
  vendas        Venda[]
  sessoes       Sessao[]
}

model Sessao {
  id        String   @id // hash SHA-256 do token guardado no cookie
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

// ---------- Clientes ----------

enum TipoPessoa {
  PF
  PJ
}

model Cliente {
  id                 String     @id @default(cuid())
  tipo               TipoPessoa
  nome               String     // PF: nome completo | PJ: razão social
  nomeFantasia       String?
  documento          String     @unique // CPF (11) ou CNPJ (14), só dígitos
  rg                 String?
  dataNascimento     DateTime?
  inscricaoEstadual  String?    // "ISENTO" quando for o caso
  inscricaoMunicipal String?
  email              String?
  telefone           String?
  whatsapp           String?
  observacoes        String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?  @db.Char(2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  aparelhos Aparelho[]
  ordens    OrdemServico[]
  vendas    Venda[]
  contatos  ClienteContato[]
  enderecos ClienteEndereco[]

  @@index([nome])
}

enum TipoContato {
  TELEFONE
  EMAIL
}

// Telefones e e-mails adicionais (os principais ficam no próprio Cliente).
model ClienteContato {
  id        String      @id @default(cuid())
  clienteId String
  cliente   Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo      TipoContato
  valor     String      // telefone só com dígitos ou e-mail
  rotulo    String?     // ex.: "Trabalho", "Esposa", "Financeiro"
  whatsapp  Boolean     @default(false)
  ordem     Int         @default(0)

  @@index([clienteId])
  @@index([valor])
}

// Endereços adicionais (o principal fica no próprio Cliente).
model ClienteEndereco {
  id          String  @id @default(cuid())
  clienteId   String
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rotulo      String? // ex.: "Comercial", "Entrega", "Cobrança"
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String? @db.Char(2)
  ordem       Int     @default(0)

  @@index([clienteId])
}

// ---------- Produtos, peças e serviços ----------

enum TipoProduto {
  APARELHO   // iPhone, iPad, Mac, Watch... controlado por IMEI/serial
  PECA       // peça de reposição
  ACESSORIO
}

model Produto {
  id            String      @id @default(cuid())
  tipo          TipoProduto
  descricao     String
  codigoBarras  String?     @unique
  sku           String?     @unique
  marca         String?     @default("Apple")
  modelo        String?     // ex.: "iPhone 15 Pro"
  unidade       String      @default("UN")
  ncm           String?
  cest          String?
  precoCusto    Decimal     @default(0) @db.Decimal(12, 2)
  precoVenda    Decimal     @default(0) @db.Decimal(12, 2)
  estoque       Int         @default(0) // saldo de itens não serializados
  estoqueMinimo Int         @default(0)
  ativo         Boolean     @default(true)
  criadoEm      DateTime    @default(now())

  compativelCom String[]    // peças: modelos compatíveis

  unidades      Aparelho[]
  movimentos    MovimentoEstoque[]
  itensVenda    ItemVenda[]
  itensOS       ItemOS[]

  @@index([descricao])
}

model Servico {
  id          String  @id @default(cuid())
  descricao   String
  valor       Decimal @default(0) @db.Decimal(12, 2)
  codigoLC116 String? // código do serviço para NFS-e
  ativo       Boolean @default(true)

  itensOS ItemOS[]
}

// ---------- Aparelhos (unidade física, com IMEI/serial) ----------

enum SituacaoAparelho {
  EM_ESTOQUE
  VENDIDO
  DO_CLIENTE   // aparelho do cliente, entrou só para manutenção
  RESERVADO
  DEVOLVIDO
}

enum CondicaoAparelho {
  NOVO
  SEMINOVO_A
  SEMINOVO_B
  SEMINOVO_C
}

model Aparelho {
  id            String           @id @default(cuid())
  produtoId     String?
  produto       Produto?         @relation(fields: [produtoId], references: [id])
  clienteId     String?          // dono atual (cliente) quando não é estoque da loja
  cliente       Cliente?         @relation(fields: [clienteId], references: [id])
  modelo        String           // ex.: "iPhone 13 128GB"
  cor           String?
  capacidade    String?
  imei          String?          @unique
  imei2         String?
  serial        String?          @unique
  condicao      CondicaoAparelho @default(NOVO)
  situacao      SituacaoAparelho
  saudeBateria  Int?             // %
  custo         Decimal?         @db.Decimal(12, 2)
  garantiaAte   DateTime?
  observacoes   String?
  criadoEm      DateTime         @default(now())

  ordens     OrdemServico[]
  itensVenda ItemVenda[]
  trocaEm    Pagamento?     @relation("AparelhoTroca")
  verificacoes VerificacaoImei[]
}

// ---------- Verificação de IMEI (serviços externos) ----------

enum FonteVerificacao {
  ANATEL   // Celular Legal (roubo, furto, irregular) via Infosimples
  IMEI_ORG // iCloud / Buscar, blacklist GSMA, operadora e garantia Apple
}

enum SituacaoVerificacao {
  OK
  ALERTA     // resposta que não deu para interpretar com certeza
  RESTRICAO  // roubo, furto, blacklist ou iCloud ativo
  ERRO       // o serviço falhou ou recusou a consulta
}

model VerificacaoImei {
  id         String              @id @default(cuid())
  imei       String
  aparelhoId String?
  aparelho   Aparelho?           @relation(fields: [aparelhoId], references: [id], onDelete: SetNull)
  fonte      FonteVerificacao
  situacao   SituacaoVerificacao
  resumo     String
  detalhes   Json?               // resposta bruta do serviço
  usuarioId  String?
  criadoEm   DateTime            @default(now())

  @@index([imei, criadoEm])
}

// ---------- Ordens de serviço ----------

enum TipoSenha {
  NENHUMA
  NUMERICA
  ALFANUMERICA
  PADRAO      // desenho: sequência de pontos 1 a 9
  NAO_INFORMADA
}

enum StatusOS {
  ABERTA
  EM_ANALISE
  ORCAMENTO_ENVIADO
  APROVADA
  EM_EXECUCAO
  CONCLUIDA
  ENTREGUE
  CANCELADA
}

model OrdemServico {
  id              String   @id @default(cuid())
  numero          Int      @unique @default(autoincrement())
  clienteId       String
  cliente         Cliente  @relation(fields: [clienteId], references: [id])
  aparelhoId      String?
  aparelho        Aparelho? @relation(fields: [aparelhoId], references: [id])
  tecnicoId       String?
  tecnico         Usuario? @relation("TecnicoOS", fields: [tecnicoId], references: [id])
  status          StatusOS @default(ABERTA)
  defeitoRelatado String
  diagnostico     String?
  checklist       Json?    // { "tela": "OK" | "DEFEITO" | "NAO_TESTADO", ... } na entrada
  icloudBloqueado Boolean?
  tipoSenha       TipoSenha @default(NENHUMA)
  senhaAparelho   String?  // criptografada (AES-256-GCM) com APP_SECRET
  marcasUso       String?  // riscos, amassados, trincas já existentes
  acessorios      String[] // o que o cliente deixou junto (capa, carregador...)
  precisaBackup   Boolean  @default(false)
  backupObs       String?  // ex.: "fazer backup das fotos antes do reparo"
  previsaoEntrega DateTime?
  garantiaDias    Int      @default(90)
  desconto        Decimal  @default(0) @db.Decimal(12, 2)
  total           Decimal  @default(0) @db.Decimal(12, 2)
  osOrigemId      String?  // retorno em garantia
  osOrigem        OrdemServico?  @relation("RetornoGarantia", fields: [osOrigemId], references: [id])
  retornos        OrdemServico[] @relation("RetornoGarantia")
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  entregueEm      DateTime?

  itens     ItemOS[]
  historico HistoricoOS[]

  @@index([status])
}

model ItemOS {
  id         String       @id @default(cuid())
  osId       String
  os         OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  produtoId  String?      // peça
  produto    Produto?     @relation(fields: [produtoId], references: [id])
  servicoId  String?
  servico    Servico?     @relation(fields: [servicoId], references: [id])
  descricao  String
  quantidade Int          @default(1)
  valorUnit  Decimal      @db.Decimal(12, 2)
}

model HistoricoOS {
  id       String       @id @default(cuid())
  osId     String
  os       OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  status   StatusOS
  nota     String?
  criadoEm DateTime     @default(now())
}

// ---------- Vendas ----------

enum StatusVenda {
  ORCAMENTO
  FINALIZADA
  CANCELADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  BOLETO
  A_PRAZO
  TROCA     // valor de aparelho recebido na troca
}

model Venda {
  id         String      @id @default(cuid())
  numero     Int         @unique @default(autoincrement())
  clienteId  String?
  cliente    Cliente?    @relation(fields: [clienteId], references: [id])
  vendedorId String?
  vendedor   Usuario?    @relation(fields: [vendedorId], references: [id])
  status     StatusVenda @default(ORCAMENTO)
  subtotal   Decimal     @default(0) @db.Decimal(12, 2) // soma dos itens já com desconto por item
  desconto   Decimal     @default(0) @db.Decimal(12, 2) // desconto geral da venda
  total      Decimal     @default(0) @db.Decimal(12, 2)
  observacoes String?
  criadoEm   DateTime    @default(now())
  canceladaEm DateTime?

  itens      ItemVenda[]
  pagamentos Pagamento[]
}

model ItemVenda {
  id         String    @id @default(cuid())
  vendaId    String
  venda      Venda     @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto   @relation(fields: [produtoId], references: [id])
  aparelhoId String?   // unidade vendida (IMEI/serial)
  aparelho   Aparelho? @relation(fields: [aparelhoId], references: [id])
  descricao  String
  quantidade Int       @default(1)
  valorUnit  Decimal   @db.Decimal(12, 2)
  desconto   Decimal   @default(0) @db.Decimal(12, 2) // desconto do item (em R$)
  garantiaDias Int?
}

model Pagamento {
  id       String         @id @default(cuid())
  vendaId  String
  venda    Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  forma    FormaPagamento
  valor    Decimal        @db.Decimal(12, 2)
  parcelas Int            @default(1)
  aparelhoTrocaId String?  @unique // aparelho recebido na troca
  aparelhoTroca   Aparelho? @relation("AparelhoTroca", fields: [aparelhoTrocaId], references: [id])
}

// ---------- Estoque ----------

enum TipoMovimento {
  ENTRADA_NOTA
  ENTRADA_TROCA
  VENDA
  USO_OS
  AJUSTE
  DEVOLUCAO
}

model MovimentoEstoque {
  id         String        @id @default(cuid())
  produtoId  String
  produto    Produto       @relation(fields: [produtoId], references: [id])
  tipo       TipoMovimento
  quantidade Int           // positivo entra, negativo sai
  custoUnit  Decimal?      @db.Decimal(12, 2)
  referencia String?       // ex.: "Venda 12", "OS 45", "NF 1234"
  criadoEm   DateTime      @default(now())

  @@index([produtoId, criadoEm])
}
