// Modelo de dados do iDesk (MVP: cadastros, aparelhos, OS, vendas e estoque).
// Valores monetários em Decimal(12,2). Documentos (CPF/CNPJ) guardados só com dígitos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // conexão direta (sem pooler) usada nas migrações; localmente é igual à DATABASE_URL
}

// ---------- Lojas (empresas que usam o sistema) ----------

// Cada loja só enxerga os próprios dados: as tabelas têm empresaId, preenchido e filtrado
// automaticamente pelo cliente do Prisma em src/lib/db.ts.
model Empresa {
  id             String   @id @default(cuid())
  nome           String // nome que aparece no sistema, na impressão e nos e-mails
  razaoSocial    String?
  documento      String? // CNPJ ou CPF, só dígitos
  telefone       String?
  email          String?
  endereco       String?
  site           String?
  corDestaque    String? // ex.: "#0071e3"
  logo           Bytes?
  logoTipo       String? // ex.: "image/png"
  logoVersao     Int      @default(0)
  // E-mail próprio da loja; sem isso vale o SMTP do servidor
  smtpHost       String?
  smtpPorta      Int?
  smtpSeguro     Boolean  @default(false)
  smtpUsuario    String?
  smtpSenha      String? // criptografada com APP_SECRET
  emailRemetente String?
  ativa          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
}

// Próximo número de OS, venda e entrega de cada loja.
model Contador {
  empresaId String
  chave     String // "os", "venda", "entrega"
  valor     Int    @default(0)

  @@id([empresaId, chave])
}

// ---------- Usuários ----------

enum Perfil {
  ADMIN
  VENDEDOR
  TECNICO
  FINANCEIRO
  ESTAGIARIO
}

model Usuario {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  nome       String
  email      String   @unique
  senhaHash  String
  perfil     Perfil   @default(VENDEDOR)
  ativo      Boolean  @default(true)
  superAdmin Boolean  @default(false) // dono do sistema: cria e gerencia as lojas
  criadoEm   DateTime @default(now())

  ordensTecnico OrdemServico[] @relation("TecnicoOS")
  vendas        Venda[]
  sessoes       Sessao[]
  entregas      Entrega[]

  @@index([empresaId])
}

model Sessao {
  id        String   @id // hash SHA-256 do token guardado no cookie
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
}

// ---------- Clientes ----------

enum TipoPessoa {
  PF
  PJ
}

model Cliente {
  id                 String     @id @default(cuid())
  empresaId          String     @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  tipo               TipoPessoa
  nome               String // PF: nome completo | PJ: razão social
  nomeFantasia       String?
  documento          String // CPF (11) ou CNPJ (14), só dígitos
  rg                 String?
  dataNascimento     DateTime?
  inscricaoEstadual  String? // "ISENTO" quando for o caso
  inscricaoMunicipal String?
  email              String?
  telefone           String?
  whatsapp           String?
  observacoes        String?

  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String? @db.Char(2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  aparelhos    Aparelho[]
  ordens       OrdemServico[]
  vendas       Venda[]
  contatos     ClienteContato[]
  enderecos    ClienteEndereco[]
  agendamentos Agendamento[]
  entregas     Entrega[]
  lancamentos  Lancamento[]

  @@unique([empresaId, documento])
  @@index([nome])
  @@index([empresaId])
}

enum TipoContato {
  TELEFONE
  EMAIL
}

// Telefones e e-mails adicionais (os principais ficam no próprio Cliente).
model ClienteContato {
  id        String      @id @default(cuid())
  empresaId String      @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  clienteId String
  cliente   Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo      TipoContato
  valor     String // telefone só com dígitos ou e-mail
  rotulo    String? // ex.: "Trabalho", "Esposa", "Financeiro"
  whatsapp  Boolean     @default(false)
  ordem     Int         @default(0)

  @@index([clienteId])
  @@index([valor])
  @@index([empresaId])
}

// Endereços adicionais (o principal fica no próprio Cliente).
model ClienteEndereco {
  id          String  @id @default(cuid())
  empresaId   String  @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  clienteId   String
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rotulo      String? // ex.: "Comercial", "Entrega", "Cobrança"
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String? @db.Char(2)
  ordem       Int     @default(0)

  @@index([clienteId])
  @@index([empresaId])
}

// ---------- Produtos, peças e serviços ----------

enum TipoProduto {
  APARELHO // iPhone, iPad, Mac, Watch... controlado por IMEI/serial
  PECA // peça de reposição
  ACESSORIO
}

model Produto {
  id            String      @id @default(cuid())
  empresaId     String      @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  tipo          TipoProduto
  descricao     String
  codigoBarras  String?
  sku           String?
  marca         String?     @default("Apple")
  modelo        String? // ex.: "iPhone 15 Pro"
  unidade       String      @default("UN")
  ncm           String?
  cest          String?
  precoCusto    Decimal     @default(0) @db.Decimal(12, 2)
  precoVenda    Decimal     @default(0) @db.Decimal(12, 2)
  estoque       Int         @default(0) // saldo de itens não serializados
  estoqueMinimo Int         @default(0)
  ativo         Boolean     @default(true)
  criadoEm      DateTime    @default(now())

  compativelCom String[] // peças: modelos compatíveis

  unidades           Aparelho[]
  movimentos         MovimentoEstoque[]
  itensVenda         ItemVenda[]
  itensOS            ItemOS[]
  vinculosFornecedor VinculoProdutoFornecedor[]

  @@unique([empresaId, codigoBarras])
  @@unique([empresaId, sku])
  @@index([descricao])
  @@index([empresaId])
}

model Servico {
  id          String  @id @default(cuid())
  empresaId   String  @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  descricao   String
  valor       Decimal @default(0) @db.Decimal(12, 2)
  codigoLC116 String? // código do serviço para NFS-e
  ativo       Boolean @default(true)

  itensOS ItemOS[]

  @@index([empresaId])
}

// ---------- Aparelhos (unidade física, com IMEI/serial) ----------

enum SituacaoAparelho {
  EM_ESTOQUE
  VENDIDO
  DO_CLIENTE // aparelho do cliente, entrou só para manutenção
  RESERVADO
  DEVOLVIDO
}

enum CondicaoAparelho {
  NOVO
  SEMINOVO_A
  SEMINOVO_B
  SEMINOVO_C
}

model Aparelho {
  id           String           @id @default(cuid())
  empresaId    String           @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  produtoId    String?
  produto      Produto?         @relation(fields: [produtoId], references: [id])
  clienteId    String? // dono atual (cliente) quando não é estoque da loja
  cliente      Cliente?         @relation(fields: [clienteId], references: [id])
  modelo       String // ex.: "iPhone 13 128GB"
  cor          String?
  capacidade   String?
  imei         String?
  imei2        String?
  serial       String?
  condicao     CondicaoAparelho @default(NOVO)
  situacao     SituacaoAparelho
  saudeBateria Int? // %
  custo        Decimal?         @db.Decimal(12, 2)
  garantiaAte  DateTime?
  observacoes  String?
  criadoEm     DateTime         @default(now())

  ordens       OrdemServico[]
  itensVenda   ItemVenda[]
  trocaEm      Pagamento?        @relation("AparelhoTroca")
  verificacoes VerificacaoImei[]

  @@unique([empresaId, imei])
  @@unique([empresaId, serial])
  @@index([empresaId])
}

// ---------- Verificação de IMEI (serviços externos) ----------

enum FonteVerificacao {
  ANATEL // Celular Legal (roubo, furto, irregular) via Infosimples
  IMEI_ORG // iCloud / Buscar, blacklist GSMA, operadora e garantia Apple
}

enum SituacaoVerificacao {
  OK
  ALERTA // resposta que não deu para interpretar com certeza
  RESTRICAO // roubo, furto, blacklist ou iCloud ativo
  ERRO // o serviço falhou ou recusou a consulta
}

model VerificacaoImei {
  id         String              @id @default(cuid())
  empresaId  String              @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  imei       String
  aparelhoId String?
  aparelho   Aparelho?           @relation(fields: [aparelhoId], references: [id], onDelete: SetNull)
  fonte      FonteVerificacao
  situacao   SituacaoVerificacao
  resumo     String
  detalhes   Json? // resposta bruta do serviço
  usuarioId  String?
  criadoEm   DateTime            @default(now())

  @@index([imei, criadoEm])
  @@index([empresaId])
}

// ---------- Ordens de serviço ----------

enum TipoSenha {
  NENHUMA
  NUMERICA
  ALFANUMERICA
  PADRAO // desenho: sequência de pontos 1 a 9
  NAO_INFORMADA
}

enum StatusOS {
  ABERTA
  EM_ANALISE
  ORCAMENTO_ENVIADO
  APROVADA
  EM_EXECUCAO
  CONCLUIDA
  ENTREGUE
  CANCELADA
}

model OrdemServico {
  id              String         @id @default(cuid())
  empresaId       String         @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  numero          Int            @default(dbgenerated("(current_setting('idesk.numero'::text))::integer")) // sequencial por loja (tabela Contador), preenchido por src/lib/db.ts
  clienteId       String
  cliente         Cliente        @relation(fields: [clienteId], references: [id])
  aparelhoId      String?
  aparelho        Aparelho?      @relation(fields: [aparelhoId], references: [id])
  tecnicoId       String?
  tecnico         Usuario?       @relation("TecnicoOS", fields: [tecnicoId], references: [id])
  status          StatusOS       @default(ABERTA)
  defeitoRelatado String
  diagnostico     String?
  checklist       Json? // { "tela": "OK" | "DEFEITO" | "NAO_TESTADO", ... } na entrada
  icloudBloqueado Boolean?
  tipoSenha       TipoSenha      @default(NENHUMA)
  senhaAparelho   String? // criptografada (AES-256-GCM) com APP_SECRET
  marcasUso       String? // riscos, amassados, trincas já existentes
  acessorios      String[] // o que o cliente deixou junto (capa, carregador...)
  precisaBackup   Boolean        @default(false)
  backupObs       String? // ex.: "fazer backup das fotos antes do reparo"
  previsaoEntrega DateTime?
  garantiaDias    Int            @default(90)
  desconto        Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @default(0) @db.Decimal(12, 2)
  osOrigemId      String? // retorno em garantia
  osOrigem        OrdemServico?  @relation("RetornoGarantia", fields: [osOrigemId], references: [id])
  retornos        OrdemServico[] @relation("RetornoGarantia")
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt
  entregueEm      DateTime?

  itens       ItemOS[]
  fotos       FotoOS[]
  historico   HistoricoOS[]
  entregas    Entrega[]
  lancamentos Lancamento[]

  @@unique([empresaId, numero])
  @@index([status])
  @@index([empresaId])
}

model ItemOS {
  id         String       @id @default(cuid())
  empresaId  String       @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  osId       String
  os         OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  produtoId  String? // peça
  produto    Produto?     @relation(fields: [produtoId], references: [id])
  servicoId  String?
  servico    Servico?     @relation(fields: [servicoId], references: [id])
  descricao  String
  quantidade Int          @default(1)
  valorUnit  Decimal      @db.Decimal(12, 2)

  @@index([empresaId])
}

enum TipoFoto {
  GERAL // foto geral do aparelho na entrada
  RISCO
  AMASSADO
  QUEBRADO // tela ou vidro quebrado/trincado
  OUTRO
}

// Fotos do aparelho na entrada (danos físicos). Guardadas no banco já reduzidas (JPEG ~1600px).
model FotoOS {
  id        String        @id @default(cuid())
  empresaId String        @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  osId      String? // vazio enquanto a OS ainda está sendo aberta
  os        OrdemServico? @relation(fields: [osId], references: [id], onDelete: Cascade)
  tipo      TipoFoto      @default(GERAL)
  legenda   String?
  mime      String
  dados     Bytes
  tamanho   Int
  usuarioId String?
  criadoEm  DateTime      @default(now())

  @@index([osId])
  @@index([empresaId])
}

model HistoricoOS {
  id        String       @id @default(cuid())
  empresaId String       @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  osId      String
  os        OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  status    StatusOS
  nota      String?
  criadoEm  DateTime     @default(now())

  @@index([empresaId])
}

// ---------- Vendas ----------

enum StatusVenda {
  ORCAMENTO
  FINALIZADA
  CANCELADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  TRANSFERENCIA
  DEBITO
  CREDITO
  BOLETO
  A_PRAZO
  TROCA // valor de aparelho recebido na troca
}

model Venda {
  id          String      @id @default(cuid())
  empresaId   String      @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  numero      Int         @default(dbgenerated("(current_setting('idesk.numero'::text))::integer")) // sequencial por loja (tabela Contador), preenchido por src/lib/db.ts
  clienteId   String?
  cliente     Cliente?    @relation(fields: [clienteId], references: [id])
  vendedorId  String?
  vendedor    Usuario?    @relation(fields: [vendedorId], references: [id])
  status      StatusVenda @default(ORCAMENTO)
  subtotal    Decimal     @default(0) @db.Decimal(12, 2) // soma dos itens já com desconto por item
  desconto    Decimal     @default(0) @db.Decimal(12, 2) // desconto geral da venda
  total       Decimal     @default(0) @db.Decimal(12, 2)
  observacoes String?
  criadoEm    DateTime    @default(now())
  canceladaEm DateTime?

  itens       ItemVenda[]
  pagamentos  Pagamento[]
  entregas    Entrega[]
  lancamentos Lancamento[]
  notas       NotaFiscal[]

  @@unique([empresaId, numero])
  @@index([empresaId])
}

model ItemVenda {
  id           String    @id @default(cuid())
  empresaId    String    @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  vendaId      String
  venda        Venda     @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId    String
  produto      Produto   @relation(fields: [produtoId], references: [id])
  aparelhoId   String? // unidade vendida (IMEI/serial)
  aparelho     Aparelho? @relation(fields: [aparelhoId], references: [id])
  descricao    String
  quantidade   Int       @default(1)
  valorUnit    Decimal   @db.Decimal(12, 2)
  desconto     Decimal   @default(0) @db.Decimal(12, 2) // desconto do item (em R$)
  garantiaDias Int?

  @@index([empresaId])
}

model Pagamento {
  id              String         @id @default(cuid())
  empresaId       String         @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  vendaId         String
  venda           Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  forma           FormaPagamento
  valor           Decimal        @db.Decimal(12, 2)
  parcelas        Int            @default(1)
  aparelhoTrocaId String?        @unique // aparelho recebido na troca
  aparelhoTroca   Aparelho?      @relation("AparelhoTroca", fields: [aparelhoTrocaId], references: [id])

  @@index([empresaId])
}

// ---------- Estoque ----------

enum TipoMovimento {
  ENTRADA_NOTA
  ENTRADA_TROCA
  VENDA
  USO_OS
  AJUSTE
  DEVOLUCAO
}

model MovimentoEstoque {
  id            String        @id @default(cuid())
  empresaId     String        @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  produtoId     String
  produto       Produto       @relation(fields: [produtoId], references: [id])
  tipo          TipoMovimento
  quantidade    Int // positivo entra, negativo sai
  custoUnit     Decimal?      @db.Decimal(12, 2)
  referencia    String? // ex.: "Venda 12", "OS 45", "NF 1234"
  notaEntradaId String?
  notaEntrada   NotaEntrada?  @relation(fields: [notaEntradaId], references: [id])
  criadoEm      DateTime      @default(now())

  @@index([produtoId, criadoEm])
  @@index([empresaId])
}

// ---------- Financeiro ----------

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum StatusLancamento {
  PENDENTE // a receber / a pagar
  PAGO // realizado (entrou ou saiu do caixa)
  CANCELADO
}

model CategoriaFinanceira {
  id        String         @id @default(cuid())
  empresaId String         @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  nome      String
  tipo      TipoLancamento
  ativa     Boolean        @default(true)

  lancamentos Lancamento[]

  @@unique([empresaId, nome, tipo])
  @@index([empresaId])
}

model Lancamento {
  id            String               @id @default(cuid())
  empresaId     String               @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  tipo          TipoLancamento
  status        StatusLancamento     @default(PENDENTE)
  descricao     String
  valor         Decimal              @db.Decimal(12, 2)
  vencimento    DateTime // data prevista
  pagoEm        DateTime? // data em que entrou/saiu do caixa
  forma         FormaPagamento?
  parcela       Int? // ex.: 2 (de 10)
  totalParcelas Int?
  categoriaId   String?
  categoria     CategoriaFinanceira? @relation(fields: [categoriaId], references: [id])
  clienteId     String?
  cliente       Cliente?             @relation(fields: [clienteId], references: [id])
  fornecedorId  String?
  fornecedor    Fornecedor?          @relation(fields: [fornecedorId], references: [id])
  vendaId       String?
  venda         Venda?               @relation(fields: [vendaId], references: [id])
  osId          String?
  os            OrdemServico?        @relation(fields: [osId], references: [id])
  notaEntradaId String?
  notaEntrada   NotaEntrada?         @relation(fields: [notaEntradaId], references: [id])
  observacoes   String?
  usuarioId     String?
  criadoEm      DateTime             @default(now())

  @@index([vencimento])
  @@index([pagoEm])
  @@index([tipo, status])
  @@index([empresaId])
}

// ---------- Fornecedores e notas de entrada ----------

model Fornecedor {
  id                String   @id @default(cuid())
  empresaId         String   @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  cnpj              String // CNPJ ou CPF, só dígitos
  razaoSocial       String
  nomeFantasia      String?
  inscricaoEstadual String?
  telefone          String?
  email             String?
  cidade            String?
  uf                String?  @db.Char(2)
  criadoEm          DateTime @default(now())

  notas       NotaEntrada[]
  lancamentos Lancamento[]
  vinculos    VinculoProdutoFornecedor[]

  @@unique([empresaId, cnpj])
  @@index([empresaId])
}

// Lembra qual produto do cadastro corresponde ao código do produto na nota do fornecedor.
model VinculoProdutoFornecedor {
  id               String     @id @default(cuid())
  empresaId        String     @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  fornecedorId     String
  fornecedor       Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  codigoFornecedor String
  produtoId        String
  produto          Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fatorConversao   Int        @default(1) // ex.: 1 caixa na nota = 12 unidades

  @@unique([fornecedorId, codigoFornecedor])
  @@index([empresaId])
}

model NotaEntrada {
  id           String     @id @default(cuid())
  empresaId    String     @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  chave        String // chave de acesso (44 dígitos)
  numero       String
  serie        String
  emissao      DateTime
  valorTotal   Decimal    @db.Decimal(12, 2)
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  xml          String // XML original (guardar por 5 anos)
  usuarioId    String?
  criadoEm     DateTime   @default(now())

  lancamentos Lancamento[]
  movimentos  MovimentoEstoque[]

  @@unique([empresaId, chave])
  @@index([empresaId])
}

// ---------- Emissão de notas (via Focus NFe) ----------

enum RegimeTributario {
  SIMPLES_NACIONAL // CRT 1
  SIMPLES_EXCESSO // CRT 2 (excesso de sublimite)
  NORMAL // CRT 3 (Lucro Presumido ou Real)
  MEI // CRT 4
}

enum AmbienteFiscal {
  HOMOLOGACAO
  PRODUCAO
}

// Registro único (id "empresa") com os dados fiscais e as regras padrão de impostos.
// Confirme os códigos com o contador antes de emitir em produção.
model EmpresaFiscal {
  id                    String           @id @default(cuid())
  empresaId             String           @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  cnpj                  String
  razaoSocial           String
  nomeFantasia          String?
  inscricaoEstadual     String?
  uf                    String           @db.Char(2)
  regime                RegimeTributario @default(SIMPLES_NACIONAL)
  ambiente              AmbienteFiscal   @default(HOMOLOGACAO)
  icmsSituacao          String           @default("102") // CSOSN no Simples; CST no regime normal
  icmsAliquota          Decimal          @default(0) @db.Decimal(5, 2)
  pisCofinsCst          String           @default("07")
  cfopDentroEstado      String           @default("5102")
  cfopForaEstado        String           @default("6102")
  origemPadrao          String           @default("0") // 0 nacional, 1 e 2 importado
  naturezaOperacao      String           @default("Venda de mercadoria")
  informacoesFisco      String? // texto obrigatório do Simples, por exemplo
  focusTokenHomologacao String? // token da Focus NFe da loja, criptografado; sem ele vale o do servidor
  focusTokenProducao    String?
  atualizadoEm          DateTime         @updatedAt

  @@unique([empresaId])
}

enum ModeloNota {
  NFE // modelo 55
  NFCE // modelo 65
}

enum StatusNota {
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  ERRO
}

model NotaFiscal {
  id           String         @id @default(cuid())
  empresaId    String         @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  referencia   String         @unique // "ref" enviada ao provedor
  modelo       ModeloNota
  ambiente     AmbienteFiscal
  status       StatusNota     @default(PROCESSANDO)
  vendaId      String
  venda        Venda          @relation(fields: [vendaId], references: [id])
  numero       String?
  serie        String?
  chave        String?
  mensagem     String?
  caminhoDanfe String?
  caminhoXml   String?
  usuarioId    String?
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  canceladaEm  DateTime?

  @@index([vendaId])
  @@index([empresaId])
}

// ---------- Agenda e entregas ----------

// Configurações da loja (registro único "loja").
model LojaConfig {
  id                      String   @id @default(cuid())
  empresaId               String   @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  endereco                String? // ponto de partida das entregas
  latitude                Float?
  longitude               Float?
  abreAs                  String   @default("09:00")
  fechaAs                 String   @default("18:00")
  diasSemana              Int[]    @default([1, 2, 3, 4, 5, 6]) // 0 = domingo
  duracaoAtendimento      Int      @default(30) // minutos de cada horário da agenda
  atendimentosSimultaneos Int      @default(1) // quantos clientes a loja atende ao mesmo tempo
  minutosNoLocalEntrega   Int      @default(10)
  atualizadoEm            DateTime @updatedAt

  @@unique([empresaId])
}

enum MotivoAgendamento {
  REPARO
  ORCAMENTO
  COMPRA
  RETIRADA
  TROCA
  OUTRO
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  ATENDIDO
  FALTOU
  CANCELADO
}

model Agendamento {
  id           String            @id @default(cuid())
  empresaId    String            @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  inicio       DateTime
  fim          DateTime
  clienteId    String?
  cliente      Cliente?          @relation(fields: [clienteId], references: [id])
  nome         String
  telefone     String?
  motivo       MotivoAgendamento @default(REPARO)
  aparelho     String?
  observacoes  String?
  status       StatusAgendamento @default(AGENDADO)
  usuarioId    String?
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt

  @@index([inicio])
  @@index([empresaId])
}

enum TipoEntrega {
  ENTREGA
  COLETA
}

enum StatusEntrega {
  PENDENTE
  EM_ROTA
  CONCLUIDA
  CANCELADA
}

model Entrega {
  id            String        @id @default(cuid())
  empresaId     String        @default(dbgenerated("current_setting('idesk.empresa_id'::text)")) // loja dona do registro: preenchido por src/lib/db.ts; sem isso o insert falha
  numero        Int           @default(dbgenerated("(current_setting('idesk.numero'::text))::integer")) // sequencial por loja (tabela Contador), preenchido por src/lib/db.ts
  tipo          TipoEntrega   @default(ENTREGA)
  status        StatusEntrega @default(PENDENTE)
  clienteId     String
  cliente       Cliente       @relation(fields: [clienteId], references: [id])
  vendaId       String?
  venda         Venda?        @relation(fields: [vendaId], references: [id])
  osId          String?
  os            OrdemServico? @relation(fields: [osId], references: [id])
  endereco      String
  agendadaPara  DateTime?
  distanciaKm   Float? // só ida
  minutosIda    Int?
  minutosTotal  Int? // ida + tempo no local + volta
  taxa          Decimal       @default(0) @db.Decimal(12, 2)
  responsavelId String?
  responsavel   Usuario?      @relation(fields: [responsavelId], references: [id])
  observacoes   String?
  criadoEm      DateTime      @default(now())
  concluidaEm   DateTime?

  @@unique([empresaId, numero])
  @@index([agendadaPara])
  @@index([empresaId])
}
